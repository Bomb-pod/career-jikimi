# career-jikimi 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#   .env에서 JWT_SECRET과 OPENAI_API_KEY를 채운다
#   docker compose up --build
#
# `.env`는 커밋되지 않는다(.gitignore). 커밋되는 것은 이 템플릿 하나뿐이다
# (FR-1.4, NFR-6).

# ---------------------------------------------------------------------------
# DB — core/db가 쓴다
# ---------------------------------------------------------------------------
# 호스트명 `db`는 compose 서비스 이름이다. db 컨테이너는 호스트에 포트를 노출하지
# 않으므로 이 URL은 compose 내부 네트워크에서만 유효하다.
# `charset=utf8mb4`를 명시한다 — 드라이버 기본값에 기대지 않는다 (FR-9.3).
DATABASE_URL=mysql+asyncmy://app:app@db:3306/career_jikimi?charset=utf8mb4

# ---------------------------------------------------------------------------
# 인증 — U3 auth가 쓴다
# ---------------------------------------------------------------------------
# **필수. 비어 있으면 앱이 기동하지 않는다.**
# 임의의 긴 문자열을 넣는다. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# 판정 — U2 judgment가 쓴다
# ---------------------------------------------------------------------------
# **필수. 비어 있으면 앱이 기동하지 않는다.**
OPENAI_API_KEY=
# ADR-005: Structured Outputs(strict) 지원 모델이어야 한다
OPENAI_MODEL=gpt-4o-mini
# 판정에 넣는 문맥 메시지 개수 N (FR-6.2). 방 메시지가 N개 미만이면 판정을 건너뛴다
AI_CONTEXT_N=10
# score >= 임계값이면 '부적절' (FR-6.3)
AI_VERDICT_THRESHOLD=0.7
# 타임아웃 초. 재시도는 1회뿐이다 (FR-8.1).
# **5가 아니라 4다.** 5면 재시도 포함 대기가 정확히 10초이고, 연결 수립과
# 직렬화 오버헤드가 그 위에 얹혀 NFR-1의 '최악 10초 이내'를 넘긴다.
# 4면 8초 + 오버헤드로 여유가 남는다 (BR-6.7의 총 상한 10초).
AI_TIMEOUT_SECONDS=4

# ---------------------------------------------------------------------------
# CORS — main.py가 쓴다 (FR-9.5)
# ---------------------------------------------------------------------------
# 쉼표로 구분. **비어 있으면 CORS 미들웨어를 아예 붙이지 않는다.**
# 배포 구성에서는 FastAPI가 프론트엔드를 같은 오리진에서 서빙하므로 비워둔다.
# Vite dev 서버(기본 5173)로 개발할 때만 채운다:
#   CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# db 컨테이너 — mariadb 이미지가 초기화에 쓴다
# ---------------------------------------------------------------------------
# 데모 값이다. 이 DB는 호스트에 포트를 노출하지 않는다.
# MARIADB_USER/PASSWORD/DATABASE는 위 DATABASE_URL과 일치해야 한다.
MARIADB_ROOT_PASSWORD=rootpw
MARIADB_DATABASE=career_jikimi
MARIADB_USER=app
MARIADB_PASSWORD=app

# ---------------------------------------------------------------------------
# 테스트 (선택)
# ---------------------------------------------------------------------------
# tests/test_schema.py는 **실제 MariaDB**에 스키마를 만들어 제약을 검증한다.
# 이 값이 없으면 그 테스트들은 skip된다 (SQLite로 대체하지 않는다 — 복합 PK와
# utf8mb4 검증이 거짓 통과한다).
# 예: TEST_DATABASE_URL=mysql+asyncmy://root:rootpw@127.0.0.1:3306/career_jikimi_test?charset=utf8mb4
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# HuggingFace 업로드 (선택) — training/hf_upload.py 가 쓴다
# ---------------------------------------------------------------------------
# 앱 실행에는 쓰이지 않는다. 모델·데이터셋을 Hub에 올릴 때만 필요하다.
# https://huggingface.co/settings/tokens → New token → Type을 **Write**로 만든다.
# Read 토큰은 업로드가 401로 막힌다.
#
# 여기에 적는 대신 `venv\Scripts\hf.exe auth login`으로 로그인해도 된다
# (토큰이 %USERPROFILE%\.cache\huggingface\token 에 저장되고 저장소 밖에 남는다).
# !!! 이 파일은 커밋된다. 여기에 실제 토큰을 적지 말 것 !!!
#     값은 .env (gitignore 대상) 에만 넣는다. 이 줄은 항상 빈 값으로 유지한다.
#     GitHub 푸시 보호가 hf_ 토큰을 탐지해 push를 거부한다.
HF_TOKEN=
