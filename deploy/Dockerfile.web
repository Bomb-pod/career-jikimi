# career-jikimi 프론트엔드 이미지 — nginx가 정적 파일을 서빙하고 API를 프록시한다.
#
# 이 파일은 `compose.nginx.yml`에서만 쓴다. 기본 구성(`docker-compose.yml`)은
# `deploy/Dockerfile` 하나로 프론트까지 함께 굽는다 (FR-9.5).
#
#     docker compose -f compose.nginx.yml up --build
#
# **빌드 컨텍스트는 저장소 루트다** (compose의 `context: .`). 이 파일이
# `deploy/` 안에 있어도 COPY 경로는 전부 루트 기준으로 쓴다.
#
# 스테이지 2개:
#   1. frontend-build — `deploy/Dockerfile`의 같은 이름 스테이지와 동일한 절차
#   2. runtime        — nginx:alpine + 빌드 결과물 + 우리 설정
#
# **`deploy/Dockerfile`의 프론트 빌드 스테이지와 내용이 같다.** 의도적인 중복이다 —
# 두 구성을 독립적으로 띄울 수 있게 하려고 갈랐다. 프론트 빌드 절차를 고치면
# 두 파일을 같이 고쳐야 한다.

# ===========================================================================
# 1. 프론트엔드 빌드
# ===========================================================================
FROM node:22-alpine AS frontend-build

WORKDIR /build

# package.json만 먼저 복사해 의존성 레이어를 소스와 분리한다.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
# `npm run build`가 tsc --noEmit을 먼저 돌린다 — 타입 오류가 있으면
# 여기서 빌드가 멈춘다. 깨진 SPA가 이미지에 굳는 것보다 낫다.
RUN npm run build

# ===========================================================================
# 2. 런타임 — nginx
# ===========================================================================
FROM nginx:1.27-alpine AS runtime

# 배포판 기본 사이트 설정을 지운다. 남겨두면 우리 server 블록과
# 기본 블록이 같이 로드되어 어느 쪽이 응답하는지 헷갈린다.
RUN rm -f /etc/nginx/conf.d/default.conf

COPY deploy/nginx.conf /etc/nginx/conf.d/career-jikimi.conf
COPY --from=frontend-build /build/dist /usr/share/nginx/html

# **여기서 `RUN nginx -t`를 돌리지 않는다.**
#
# 처음엔 빌드 시점에 설정 오류를 잡으려고 넣었다가 뺐다. nginx는 upstream의
# 호스트명을 **설정을 읽는 시점에** DNS로 해석하는데, 빌드 중에는 compose
# 네트워크도 `app` 컨테이너도 없다. 그래서 설정이 멀쩡해도 이렇게 죽는다:
#
#     nginx: [emerg] host not found in upstream "app:8000"
#
# 즉 이 자리의 `nginx -t`는 문법이 아니라 "지금 app이 떠 있는가"를 검사한다.
# 빌드 단계에서 그건 언제나 거짓이다.
#
# 설정은 컨테이너가 뜰 때 nginx가 어차피 검사한다. 그때는 compose가
# `depends_on: service_healthy`로 app을 먼저 띄워둔 뒤이므로 이름이 풀린다.
# 설정이 잘못됐으면 `docker compose up`이 즉시 그 에러를 뱉는다.
#
# 고치는 중에 문법만 미리 보고 싶으면 호스트에서:
#   docker run --rm -v "$PWD/deploy/nginx.conf:/etc/nginx/conf.d/x.conf:ro" \
#     nginx:1.27-alpine sh -c 'sed -i s/app:8000/127.0.0.1:8000/ \
#     /etc/nginx/conf.d/x.conf && nginx -t'

EXPOSE 80

# nginx:alpine의 기본 CMD는 `nginx -g "daemon off;"` 이므로 그대로 쓴다.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/nginx-health || exit 1
